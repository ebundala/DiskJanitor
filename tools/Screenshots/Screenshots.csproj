<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the real MainWindow off-screen with sample data and saves PNGs for docs/.
       Run from the repo root: dotnet run (project tools/Screenshots) with argument docs/screenshots -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../DiskJanitor.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
  </ItemGroup>
</Project>
