<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DiskJanitor.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />

        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="#D97706" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="#DC2626" />
        </Style>
        <Style Selector="TextBlock.ok">
            <Setter Property="Foreground" Value="#16A34A" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#A32316" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#8A1D12" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#30808080" />
            <Setter Property="Foreground" Value="#90808080" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="#0C808080" />
            <Setter Property="BorderBrush" Value="#30808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Border.card.caution">
            <Setter Property="BorderBrush" Value="#D97706" />
            <Setter Property="BorderThickness" Value="4,1,1,1" />
        </Style>
        <Style Selector="Border.card.danger">
            <Setter Property="BorderBrush" Value="#DC2626" />
            <Setter Property="BorderThickness" Value="4,1,1,1" />
        </Style>
        <Style Selector="Border.card.deleted">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <Style Selector="Border.chip">
            <Setter Property="Background" Value="#22808080" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.chip.root">
            <Setter Property="Background" Value="#33DC2626" />
        </Style>
        <Style Selector="Border.chip TextBlock">
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="Border.callout">
            <Setter Property="Background" Value="#22D97706" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style Selector="ProgressBar.danger">
            <Setter Property="Foreground" Value="#DC2626" />
        </Style>
    </Application.Styles>
</Application>
