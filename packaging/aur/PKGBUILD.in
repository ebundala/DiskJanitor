# Maintainer: ebundala <https://github.com/ebundala>
# Generated by .github/workflows/release.yml from packaging/aur/PKGBUILD.in - edit it there.
pkgname=diskjanitor-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Find and delete build folders, Docker leftovers and caches on a developer machine"
arch=('x86_64')
url="https://github.com/ebundala/DiskJanitor"
license=('MIT')
depends=('glibc' 'gcc-libs' 'zlib' 'icu' 'fontconfig' 'libx11' 'libice' 'libsm')
optdepends=('polkit: relaunch as root from inside the app'
            'docker: clean Docker images, containers, volumes and build cache')
provides=('diskjanitor')
conflicts=('diskjanitor')
# Stripping corrupts the .NET single-file bundle.
options=('!strip' '!debug')
source=("DiskJanitor-linux-x64-$pkgver.tar.gz::$url/releases/download/v$pkgver/DiskJanitor-linux-x64.tar.gz"
        'diskjanitor.desktop'
        'diskjanitor.png')
sha256sums=('@TARBALL_SHA256@'
            '@DESKTOP_SHA256@'
            '@ICON_SHA256@')

package() {
  install -Dm755 DiskJanitor "$pkgdir/usr/lib/diskjanitor/DiskJanitor"
  install -d "$pkgdir/usr/bin"
  ln -s /usr/lib/diskjanitor/DiskJanitor "$pkgdir/usr/bin/diskjanitor"
  install -Dm644 diskjanitor.desktop "$pkgdir/usr/share/applications/diskjanitor.desktop"
  install -Dm644 diskjanitor.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/diskjanitor.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
